{
  "$schema": "../../node_modules/ng-packagr/ng-package.schema.json",
  "dest": "../../dist/omega-angular",
  "allowedNonPeerDependencies": ["@eslint/js", "eslint", "typescript-eslint"],
  "lib": {
    "entryFile": "src/public-api.ts"
  },
  "assets": [
    {
      "glob": "**/*",
      "input": "./eslint-then",
      "output": "/eslint-then"
    },
    {
      "glob": "**/*",
      "input": "./eslint-plugin",
      "output": "/eslint-plugin"
    },
    {
      "glob": "**/*",
      "input": "./eslint",
      "output": "/eslint"
    },
    {
      "glob": "**/*",
      "input": "./schematics",
      "output": "/schematics"
    }
  ]
}