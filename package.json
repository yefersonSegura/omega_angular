{
  "name": "omega-angular-repository",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve example",
    "build": "ng build example",
    "build:lib": "npm run lint && ng build omega-angular && node scripts/patch-omega-angular-package.mjs",
    "watch": "ng build omega-angular --watch --configuration development",
    "test": "ng test omega-angular --no-watch",
    "lint": "eslint .",
    "ecosystem": "ng generate omega-angular:ecosystem --project=example"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/platform-browser-dynamic": "^21.2.0",
    "@angular/router": "^21.2.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "omega-angular": "file:projects/omega-angular",
    "@eslint/js": "^9.21.0",
    "@angular/build": "^21.2.0",
    "@angular/cli": "^21.2.0",
    "@angular/compiler-cli": "^21.2.0",
    "@types/jasmine": "~5.1.0",
    "jasmine-core": "~5.6.0",
    "jsdom": "^28.0.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "^21.2.0",
    "eslint": "^9.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.24.0",
    "vitest": "^4.0.8"
  }
}